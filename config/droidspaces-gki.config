# DroidSpaces required options for GKI 5.4 (Xiaomi Mi 11 / venus)
# Source: https://github.com/ravindu644/Droidspaces-OSS/blob/main/Documentation/Kernel-Configuration.md
# Only the ABI-safe set from the GKI section. CFS_BANDWIDTH and CGROUP_PIDS
# are deliberately omitted because they resize scheduler/cgroup structures
# and would require rebuilding every vendor module.

# IPC
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# Namespaces
CONFIG_IPC_NS=y
CONFIG_PID_NS=y

# HW access
CONFIG_DEVTMPFS=y

# Networking
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y

# Recommended
CONFIG_USER_NS=y

# IPv6 NAT
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y

# Macvlan
CONFIG_MACVLAN=y

# UFW
CONFIG_NETFILTER_XT_TARGET_REJECT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y

# Fail2ban
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y

# tmpfs xattr / POSIX ACL (NixOS)
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# SukiSU-Ultra, built into the kernel (not an LKM)
CONFIG_KSU=y
CONFIG_KSU_MANUAL_SU=y
# CONFIG_KSU_DEBUG is not set

# Build only: keep the output small enough for this build host.
# Debug info has no effect on the running kernel or on the module ABI.
# CONFIG_DEBUG_INFO is not set
